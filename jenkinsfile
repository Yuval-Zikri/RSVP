pipeline {
    agent any

    environment {
        GIT_REPO = 'https://github.com/Yuval-Zikri/RSVP.git'
        WORK_SPACE = 'RSVP'
        DOCKER_IMAGE = 'rsvp'
        DOCKER_TAG = "v.${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                sh "rm -rf ${WORK_SPACE}"
                sh "git clone ${GIT_REPO} ${WORK_SPACE}"
            }
        }

        stage('Docker Compose Up') {
            steps {
                dir("${WORK_SPACE}") {
                    sh "docker compose -f docker-compose.yaml up -d --build"
                }
            }
        }
    }
}
