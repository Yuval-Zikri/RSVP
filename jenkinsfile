pipeline {
    agent any

    environment {
        GIT_REPO = 'https://github.com/Yuval-Zikri/RSVP.git'
        WORK_SPACE = 'RSVP'
        DOCKER_IMAGE = 'rsvp'
        DOCKER_TAG = "v.${BUILD_NUMBER}"
        DOCKER_COMPOSE_FILE = "docker-compose.yaml"
    }

    stages {
        stage('Cleanup Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout latest code') {
            steps {
                checkout scm
            }
        }

        stage('Prepare .env') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'gmail-auth', usernameVariable: 'MAIL_USER', passwordVariable: 'MAIL_PASS'),
                    string(credentialsId: 'ngrok-token', variable: 'NGROK_AUTH_TOKEN')
                ]) {
                    sh """
                    mkdir -p backend
                    cat <<EOF > backend/.env
                    BASE_URL=http://localhost:3000
                    DATABASE_URL=postgresql://user:password@postgres:5432/event_db
                    MAIL_SERVER=smtp.gmail.com
                    MAIL_PORT=587
                    MAIL_USE_TLS=True
                    MAIL_USERNAME=${MAIL_USER}
                    MAIL_PASSWORD=${MAIL_PASS}
                    NGROK_AUTHTOKEN=${NGROK_AUTH_TOKEN}
                    EOF
                    """
                }
            }
        }

        stage('Docker Compose Up') {
            steps {
                sh "docker --version"
                sh "docker ps"
                sh "docker compose version"
                sh "docker compose -f ${DOCKER_COMPOSE_FILE} up -d --build"
            }
        }

        stage('Integration Tests') {
            steps {
                script {
                    echo "Waiting for services to start..."
                    sleep 15
                    
                    // Get Backend Container ID
                    def backendId = sh(script: "docker compose -f ${DOCKER_COMPOSE_FILE} ps -q backend", returnStdout: true).trim()
                    
                    if (backendId) {
                        echo "Backend Container ID: ${backendId}"
                        
                        // Copy test script to container
                        // Note: We assume tests/integration_test.py exists in the workspace
                        sh "docker cp tests/integration_test.py ${backendId}:/app/integration_test.py"
                        
                        // FIX: Manually copy background image to workaround volume mount issues in Jenkins DnD
                        sh "docker exec ${backendId} mkdir -p /app/backgrounds"
                        sh "docker cp frontend/src/background/wadding.jpg ${backendId}:/app/backgrounds/wadding.jpg"
                        
                        // Run the test script inside the container
                        sh "docker exec ${backendId} python /app/integration_test.py"
                    } else {
                        error "Backend container not found!"
                    }
                }
            }
        }
    }
}
