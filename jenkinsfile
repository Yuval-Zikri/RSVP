pipeline {
    agent any

    environment {
        GIT_REPO = 'https://github.com/Yuval-Zikri/RSVP.git'
        WORK_SPACE = 'RSVP'
        DOCKER_IMAGE = 'rsvp'
        DOCKER_TAG = "v.${BUILD_NUMBER}"
        DOCKER_COMPOSE_FILE = "docker-compose.yaml"
    }

    stages {
        stage('Cleanup Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout Latest Code') {
            steps {
                checkout scm
            }
        }

        stage('Prepare .env') {
            steps {
                sh '''
                mkdir -p backend
                cat <<EOF > backend/.env
                BASE_URL=https://semisentimentally-geyseral-cliff.ngrok-free.dev
                DATABASE_URL=postgresql://user:password@postgres:5432/event_db
                EOF
                '''
            }
        }

        stage('Docker Compose Up') {
            steps {
                sh "docker --version"
                sh "docker compose version"
                sh "docker compose -f ${DOCKER_COMPOSE_FILE} up -d --build"
            }
        }
    }
}
